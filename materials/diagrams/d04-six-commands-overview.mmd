flowchart TB
  CTX([".cursor/context.md<br/>(project brain)<br/><i>Active Personas + one block per role</i>"])

  SP["/set-persona add &lt;role&gt;<br/><i>adds a persona block</i>"]
  SS["/setup-stack &lt;role&gt;<br/><i>writes that role's stack</i>"]
  AR["/architect &lt;role&gt;<br/><i>writes that role's plan</i>"]
  ST["/start-session &lt;role&gt;<br/><i>loads + executes</i>"]
  NS["/next-session<br/><i>wraps + hands off</i>"]
  DS["/detect-stack &lt;role&gt;<br/><i>brownfield entry,<br/>instead of /setup-stack</i>"]

  SP --> CTX
  SS --> CTX
  AR --> CTX
  ST --> CTX
  NS --> CTX
  DS --> CTX

  classDef ctx fill:#ede7f6,stroke:#4527a0,color:#000,font-weight:bold;
  classDef spine fill:#7c4dff,stroke:#4527a0,color:#fff;
  classDef side fill:#00897b,stroke:#004d40,color:#fff;
  class CTX ctx;
  class SP,SS,AR,ST,NS spine;
  class DS side;
