flowchart LR
  SP["/set-persona add &lt;role&gt;"] --> M1[(".cursor/personas/&lt;role&gt;.manifest.json<br/><i>files, hook entries, MCP servers</i>")]
  SS["/setup-stack &lt;role&gt;<br/><i>or /detect-stack &lt;role&gt;</i>"] --> M2[(".cursor/stacks/&lt;role&gt;.manifest.json<br/><i>rules, templates, examples</i>")]

  M1 --> U[/"/undo persona &lt;role&gt;<br/>| stack &lt;role&gt; | all"/]
  M2 --> U

  U --> R[["Remove exactly those files.<br/>Other roles untouched.<br/>Your work in workspaces/ kept."]]

  classDef install fill:#7c4dff,stroke:#4527a0,color:#fff;
  classDef manifest fill:#ede7f6,stroke:#4527a0,color:#000;
  classDef undo fill:#e65100,stroke:#bf360c,color:#fff,font-weight:bold;
  classDef result fill:#e8f5e9,stroke:#2e7d32,color:#000;
  class SP,SS install;
  class M1,M2 manifest;
  class U undo;
  class R result;
