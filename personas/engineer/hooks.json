{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      { "command": ".cursor/scripts/lint.sh" },
      { "command": ".cursor/scripts/type-check.sh" }
    ],
    "beforeShellExecution": [
      { "command": ".cursor/scripts/block-destructive.sh" }
    ],
    "stop": [
      { "command": ".cursor/scripts/test-runner.sh" }
    ]
  }
}
