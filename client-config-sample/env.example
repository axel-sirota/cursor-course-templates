# Organization-specific environment variables
# Distribute this to students alongside the client-config/ directory.
# Students copy this content into their .env file in the repo root.
#
# IMPORTANT: Never commit a filled-in .env file.
# The .env file in the repo root is gitignored.

# ── Engineer persona ──────────────────────────────────────────────
# GitHub Personal Access Token
# If using GitHub Enterprise, set GITHUB_HOST in personas/engineer/mcp.json
GITHUB_PAT=

# Internal PostgreSQL connection string (if used in exercises)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=

# ── Designer persona ──────────────────────────────────────────────
# Figma org-level access token
# Ask your Figma admin for an org token, or each student can generate their own
# at: https://www.figma.com/settings → Personal access tokens
FIGMA_ACCESS_TOKEN=

# ── PM persona ────────────────────────────────────────────────────
# Internal Jira (Atlassian Cloud or Server)
JIRA_URL=https://your-org.atlassian.net
JIRA_USERNAME=
JIRA_API_TOKEN=

# Internal Confluence
CONFLUENCE_URL=https://your-org.atlassian.net/wiki
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=

# Slack (optional — only needed if your org exercises use Slack)
SLACK_BOT_TOKEN=

# ── Data Scientist persona ────────────────────────────────────────
# Add your internal data platform credentials here.
# Uncomment and rename the lines below to match your stack.

# Snowflake
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=

# Internal MLflow tracking server
# MLFLOW_TRACKING_URI=

# BigQuery (uses ADC or service account — configure separately)
# GOOGLE_APPLICATION_CREDENTIALS=
# BIGQUERY_PROJECT=
