### 2. E2E Test First (MUST BE FIRST)
Reference 400-testing-first.mdc for detailed testing rules.

Write a Supertest test using skeleton's mock data as expected shape:
```typescript
// tests/routes/resources.test.ts
import request from 'supertest';
import app from '../../src/app';

describe('POST /api/resources', () => {
  it('creates a resource', async () => {
    const response = await request(app)
      .post('/api/resources')
      .set('Authorization', `Bearer ${testToken}`)
      .send({ name: 'Test Resource', description: 'Test description', ownerId: 'test-owner' });

    expect(response.status).toBe(201);
    expect(response.body.name).toBe('Test Resource');
    expect(response.body).toHaveProperty('resourceId');
    expect(response.body).toHaveProperty('createdAt');
  });
});
```

Run test - it MUST fail against the mock implementation's hardcoded values.

### 3. Prisma Migration
Reference `vibe/vibe_express_boilerplate.md` for schema patterns.

Add the model to `prisma/schema.prisma`:
```prisma
model Resource {
  id          String   @id @default(uuid())
  name        String
  description String
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@map("resources")
}
```

Generate and apply the migration:
```bash
npx prisma migrate dev --name create_resources_table
npx prisma generate
```

Migration must include:
- Table creation with proper columns
- Primary key (UUID via `@default(uuid())`)
- Foreign keys (if applicable)
- Timestamps (`createdAt`, `updatedAt`)
- Indexes for common queries
- Required fields with no default `?` marker where appropriate

### 4. Domain/DTO Models (Zod)

Create in `src/schemas/resource.schema.ts`. Zod's `.extend()` / `.omit()` / `.partial()` compose the same "layered model" concept FastAPI achieves with Pydantic inheritance:

```typescript
import { z } from 'zod';

// Base: business fields only
export const ResourceBaseSchema = z.object({
  name: z.string().min(1).max(200),
  description: z.string().min(1).max(10000),
  ownerId: z.string(),
});

// Full: includes generated/database fields
export const ResourceSchema = ResourceBaseSchema.extend({
  resourceId: z.string(),
  createdAt: z.string(),
  updatedAt: z.string(),
});

// Create: same as base (no generated fields yet)
export const ResourceCreateSchema = ResourceBaseSchema;

// Update: all fields optional
export const ResourceUpdateSchema = ResourceBaseSchema.partial();

export type Resource = z.infer<typeof ResourceSchema>;
export type ResourceCreate = z.infer<typeof ResourceCreateSchema>;
export type ResourceUpdate = z.infer<typeof ResourceUpdateSchema>;
```

### 5. Repository Implementation

Create in `src/repositories/resource.repository.ts` using the generated `PrismaClient`:

```typescript
import { PrismaClient, Resource as PrismaResource } from '@prisma/client';
import { Resource, ResourceCreate } from '../schemas/resource.schema';

export class ResourceRepository {
  constructor(private readonly prisma: PrismaClient) {}

  private toModel(row: PrismaResource): Resource {
    return {
      resourceId: row.id,
      name: row.name,
      description: row.description,
      ownerId: row.ownerId,
      createdAt: row.createdAt.toISOString(),
      updatedAt: row.updatedAt.toISOString(),
    };
  }

  async create(data: ResourceCreate): Promise<Resource> {
    const row = await this.prisma.resource.create({ data });
    return this.toModel(row);
  }

  async getById(id: string): Promise<Resource | null> {
    const row = await this.prisma.resource.findUnique({ where: { id } });
    return row ? this.toModel(row) : null;
  }

  async getAll(limit = 20, offset = 0): Promise<Resource[]> {
    const rows = await this.prisma.resource.findMany({ take: limit, skip: offset });
    return rows.map((row) => this.toModel(row));
  }

  async update(id: string, data: Partial<ResourceCreate>): Promise<Resource> {
    const row = await this.prisma.resource.update({ where: { id }, data });
    return this.toModel(row);
  }

  async delete(id: string): Promise<void> {
    await this.prisma.resource.delete({ where: { id } });
  }
}
```

Implement only the methods needed for the current endpoint.

### 6. Service Layer

Create in `src/services/resource.service.ts`:

```typescript
import { ResourceRepository } from '../repositories/resource.repository';
import { Resource, ResourceCreate } from '../schemas/resource.schema';
import { logger } from '../config/logger';

export class ResourceService {
  constructor(private readonly resourceRepo: ResourceRepository) {}

  /**
   * Create a new resource.
   * @throws Error if creation fails at the data layer.
   */
  async createResource(data: ResourceCreate): Promise<Resource> {
    try {
      return await this.resourceRepo.create(data);
    } catch (error) {
      logger.error({ err: error }, 'Error creating resource');
      throw error;
    }
  }
}
```

### 7. Processor Replacement (Controller Wiring)
Reference 500-implementation.mdc for replacement patterns.

Replace the mock body from Session 1 with a real service call:
```typescript
// Before (Phase 0 mock)
export async function createResource(req: Request, res: Response): Promise<void> {
  res.status(201).json({ resourceId: 'mock-123', ...req.body });
}

// After (Phase 1 real)
export async function createResource(req: Request, res: Response): Promise<void> {
  const parsed = ResourceCreateSchema.parse(req.body);
  const service = new ResourceService(new ResourceRepository(prisma));
  const created = await service.createResource(parsed);
  res.status(201).json(created);
}
```

### 8. Test Validation
Run E2E tests - they MUST pass now:
```bash
npx jest tests/routes/resources.test.ts -t "creates a resource"
```

If tests fail:
- Check `DATABASE_URL` and that Postgres is running
- Verify migration applied (`npx prisma migrate status`)
- Check data transformation logic in the repository mapper
- Review structured log output

