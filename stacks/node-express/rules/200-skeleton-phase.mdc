### 5. Mock Endpoint Implementation

For each endpoint in OpenAPI spec, create a mock controller returning hardcoded JSON that matches the Zod response schema.

**Pattern for POST endpoints:**
```typescript
// src/controllers/posts.controller.ts
import { Request, Response } from 'express';
import { CreatePostRequestSchema } from '../schemas/post.schema';

export async function createPost(req: Request, res: Response): Promise<void> {
  const parsed = CreatePostRequestSchema.parse(req.body);

  // MOCK IMPLEMENTATION
  res.status(201).json({
    postId: 'mock-123',
    title: parsed.title,
    content: parsed.content,
    authorId: parsed.authorId,
    createdAt: '2024-01-01T00:00:00Z',
  });
}
```

**Pattern for GET endpoints:**
```typescript
export async function getPost(req: Request, res: Response): Promise<void> {
  const { postId } = req.params;

  // MOCK IMPLEMENTATION
  res.status(200).json({
    postId,
    title: 'Mock Post Title',
    content: 'Mock post content here',
    authorId: 'mock-author-123',
    createdAt: '2024-01-01T00:00:00Z',
  });
}
```

### 6. Request/Response Validation

Create Zod schemas matching OpenAPI schemas. Because JSON, TypeScript, and Zod all use camelCase natively, there is no aliasing layer to write — the schema field names are the wire format:

```typescript
// src/schemas/post.schema.ts
import { z } from 'zod';

export const CreatePostRequestSchema = z.object({
  title: z.string().min(1).max(200),
  content: z.string().min(1).max(10000),
  authorId: z.string(),
});
export type CreatePostRequest = z.infer<typeof CreatePostRequestSchema>;

export const PostResponseSchema = z.object({
  postId: z.string(),
  title: z.string(),
  content: z.string(),
  authorId: z.string(),
  createdAt: z.string(),
});
export type PostResponse = z.infer<typeof PostResponseSchema>;
```

### 7. Routing

Wire mock controllers into an Express router:

```typescript
// src/routes/posts.ts
import { Router } from 'express';
import { createPost, getPost } from '../controllers/posts.controller';
import { requireAuth } from '../middleware/auth';

const router = Router();

router.post('/posts', requireAuth, createPost);
router.get('/posts/:postId', requireAuth, getPost);

export default router;
```

